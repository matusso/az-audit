#!/usr/bin/env python3
# Mock Azure CLI for offline testing of azure-logging-compliance-audit.sh
import sys, json, re, os, urllib.parse

args = sys.argv[1:]
LOG = os.environ.get("MOCK_AZ_LOG")
if LOG:
    with open(LOG, "a") as f:
        f.write(json.dumps(args) + "\n")

T = "11111111-1111-1111-1111-111111111111"
S1 = "aaaaaaaa-0000-0000-0000-000000000001"
S2 = "aaaaaaaa-0000-0000-0000-000000000002"
S3 = "aaaaaaaa-0000-0000-0000-000000000003"
RG = f"/subscriptions/{S1}/resourceGroups/rg-logging"
LAW = f"{RG}/providers/Microsoft.OperationalInsights/workspaces/law-sec-prod"
NS = f"{RG}/providers/Microsoft.EventHub/namespaces/eh-vigre-sec-prod"
SA = f"{RG}/providers/Microsoft.Storage/storageAccounts/stlogsprod"
KV = f"/subscriptions/{S1}/resourceGroups/rg-app/providers/Microsoft.KeyVault/vaults/kv-prod"
PG = f"/subscriptions/{S1}/resourceGroups/rg-app/providers/Microsoft.DBforPostgreSQL/flexibleServers/pg-prod"
SQL = f"/subscriptions/{S1}/resourceGroups/rg-app/providers/Microsoft.Sql/servers/sql-prod"
SQLDB = f"{SQL}/databases/appdb"
