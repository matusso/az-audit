if lp.endswith("/providers/microsoft.authorization/roledefinitions"):
    out({"value": [
        {"name": "8e3af657-a8ff-443c-a75c-2fe8c4bcb635", "properties": {"roleName": "Owner", "type": "BuiltInRole", "permissions": [{"actions": ["*"], "notActions": []}]}},
        {"name": "b24988ac-6180-42a0-ab88-20f7382dd24c", "properties": {"roleName": "Contributor", "type": "BuiltInRole", "permissions": [{"actions": ["*"], "notActions": ["Microsoft.Authorization/*/Delete", "Microsoft.Authorization/*/Write"]}]}},
        {"name": "73c42c96-874c-492b-b04d-ab87d138a893", "properties": {"roleName": "Log Analytics Reader", "type": "BuiltInRole", "permissions": [{"actions": ["*/read", "Microsoft.OperationalInsights/workspaces/search/action", "Microsoft.Support/*"], "notActions": []}]}}]})
if lp.endswith("/providers/microsoft.authorization/roleassignments"):
    scope = lp[: -len("/providers/microsoft.authorization/roleassignments")]
    if scope == LAW.lower():
        def ra(i, pid, ptype, role, sc):
            return {"id": f"{sc}/providers/Microsoft.Authorization/roleAssignments/{i}", "properties": {"principalId": pid, "principalType": ptype, "scope": sc,
                    "roleDefinitionId": f"/subscriptions/{S1}/providers/Microsoft.Authorization/roleDefinitions/{role}"}}
        out({"value": [ra("a1", "u-1", "User", "8e3af657-a8ff-443c-a75c-2fe8c4bcb635", f"/subscriptions/{S1}"),
                       ra("a2", "g-dev", "Group", "73c42c96-874c-492b-b04d-ab87d138a893", LAW),
                       ra("a3", "g-data", "Group", "b24988ac-6180-42a0-ab88-20f7382dd24c", RG)]})
