         "properties": {"hasImmutabilityPolicy": True, "hasLegalHold": False, "immutabilityPolicy": {"properties": {"immutabilityPeriodSinceCreationInDays": 365, "state": "Unlocked", "allowProtectedAppendWrites": True}}}},
        {"id": SA + "/blobServices/default/containers/insights-activity-logs", "name": "insights-activity-logs",
